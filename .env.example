# Server runtime configuration. Copy to .env locally; never commit real values.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side integrations. Keep real values out of source control and frontend bundles.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_ENABLED=auto
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only by protected backend write/sync routes.
ADMIN_API_KEY=

# Anonymous conversation session policy.
SESSION_TOKEN_BYTES=32
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_MAX_MESSAGE_LENGTH=2000
